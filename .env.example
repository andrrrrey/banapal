# ============================================================================
#  Banapal — пример переменных окружения. Скопируйте в .env и заполните.
#  .env в репозиторий НЕ коммитится (см. .gitignore). Секреты — только здесь.
# ============================================================================

# --- Общее ---------------------------------------------------------------
# Окружение: development | production
APP_ENV=development
# Публичный адрес системы (используется для CORS и ссылок). На VPS — https://<домен>
PUBLIC_URL=http://localhost

# --- База данных (PostgreSQL 16) -----------------------------------------
POSTGRES_USER=banapal
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=banapal
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Аутентификация (единый вход, Этап 1) --------------------------------
# Логин/пароль администратора для входа в дашборд и админ-панель.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me_in_production
# Секрет для подписи сессионных JWT. Сгенерируйте: openssl rand -hex 32
SESSION_SECRET=change_me_generate_with_openssl_rand_hex_32
# Время жизни сессии в минутах
SESSION_TTL_MINUTES=720

# --- Источник данных ------------------------------------------------------
# mock  — работа на демо-данных из прототипа (разработка до получения доступов)
# real  — боевые адаптеры интеграций (подключаются на Этапе E)
DATA_SOURCE=mock

# --- Интеграции (заполняются на Этапе E, когда заказчик выдаст доступы) ----
# Битрикс24
BITRIX24_WEBHOOK_URL=
BITRIX24_INBOUND_TOKEN=
# Яндекс Директ / Метрика (OAuth)
YANDEX_OAUTH_TOKEN=
YANDEX_DIRECT_LOGIN=
YANDEX_METRIKA_COUNTER_ID=
# Calltouch
CALLTOUCH_CLIENT_API_ID=
# МойСклад (JSON API 1.2)
MOYSKLAD_TOKEN=

# --- AI-слой (LLM через облачный API; модель/юрисдикция — по согласованию) --
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
