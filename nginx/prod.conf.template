# Прод-конфиг nginx: HTTPS для ${DOMAIN}, редирект с HTTP, ACME-challenge.
# Подстановка ${DOMAIN} выполняется штатным envsubst образа nginx (templates).

server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};

    # Проверка домена Let's Encrypt (webroot).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Весь остальной трафик — на HTTPS.
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN} www.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    # TLS 1.2+ (требование раздела 7.2 ТЗ)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    add_header Strict-Transport-Security "max-age=31536000" always;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # API → backend (сохраняем префикс /api).
    # ВАЖНО: хост `api` резолвим в рантайме через встроенный DNS Docker (127.0.0.11),
    # а не один раз при старте. Иначе после пересоздания контейнера api (./scripts/
    # update.sh) его IP меняется, а nginx продолжает стучаться на старый мёртвый IP —
    # это давало повторяющийся 502 при каждом обновлении. Переменная в proxy_pass
    # заставляет nginx использовать resolver на каждый запрос (с кэшем valid=10s).
    location /api/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $api_upstream http://api:8000;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # SPA: любые маршруты → index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
